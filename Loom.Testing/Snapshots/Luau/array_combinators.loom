let numbers = [1, 2, 3, 4, 5];
let doubled = numbers.select(fn(n) -> n * 2);
let weighted = numbers.select(fn(n, i) -> n * i);
let big = numbers.where(fn(n) -> n > 2);
let total = numbers.aggregate(0, fn(sum, n) -> sum + n);
let chained = numbers.select(fn(n) -> n * 2).where(fn(n) -> n > 4).aggregate(0, fn(sum, n) -> sum + n);

fn triple(n: number): number -> n * 3;
let tripled = numbers.select(triple);

let has_big = numbers.any(fn(n) -> n > 4);
let all_positive = numbers.all(fn(n) -> n > 0);
let big_count = numbers.count(fn(n) -> n > 2);
let paired = numbers.select_many(fn(n) -> [n, n * 10]);

let rows = [[1, 2], [3]];
let flat = rows.flatten();
let flat_big = rows.flatten().where(fn(n) -> n > 1);
let flat_indexed = rows.flatten().select(fn(n, i) -> n * i);
let spread_total = rows.select_many(fn(r) -> r).where(fn(n) -> n > 1).aggregate(0, fn(a, n) -> a + n);
let flat_any = rows.flatten().any(fn(n) -> n > 2);
