fn sum(..values: number[]): number {
    mut total = 0;
    for value : values
        total += value;

    return total;
}

fn combine(prefix: string, ..rest: string[]): string {
    mut result = prefix;
    for value : rest
        result += value;

    return result;
}

let s = sum(1, 2, 3, 4, 5);
print(s);
print(combine("a", "b", "c"));
