<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>loom</AssemblyName>

        <!--
            Overridden by the release workflow with the version off the tag. The placeholder is
            deliberately not a real version: a binary built anywhere else reports itself as one.
        -->
        <Version>0.0.0-dev</Version>
        <!-- Keeps the reported version to the version itself, rather than appending the commit hash. -->
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

        <!-- Requires a self-contained, platform-specific publish; see the release workflow. -->
        <PublishAot>true</PublishAot>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Loom.Core\Loom.Core.csproj" />
        <ProjectReference Include="..\Loom.Packages\Loom.Packages.csproj" />
    </ItemGroup>

</Project>
