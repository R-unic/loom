## Loom standard library

declare interface Tuple;

interface Record<K, V> {
    [K]: V;
}

interface MutRecord<K, V> {
    mut [K]: V;
}

### An array of 'T' whose serialized length prefix is written as 'L'.
###
### Identical to 'T[]' at the type level - 'L' only matters to the serializer, which reads it off the
### type argument rather than always writing the array's length as a 'u32'.
type Array<T, L: number = u32> = T[];

## Structural type utilities. Every one of these erases completely - they answer a question about a
## shape at compile time and leave nothing behind for Luau to run - which is why they live beside
## 'Record' rather than in runtime.loom: a type declared there marks every file using it as needing
## the runtime import, whether or not the type itself ever touches it.

### Every member of 'T', writable regardless of whether 'T' itself declared it so. The inverse of
### 'Readonly' - one mapped type toggles the capability on, the other off, and nothing about 'T'
### decides which: assignability is invariant on a mutable member, so a caller has to say which
### reading of a structural type it wants.
interface Mut<T> { mut [K from keyof(T)]: T[K]; }

### Every member of 'T', read-only regardless of whether 'T' declared it 'mut'. A mutable member
### widens to an immutable one but not back, so this is always a safe view to hand out - useful for
### a function that only reads its argument and wants to promise it will not write through it.
interface Readonly<T> { [K from keyof(T)]: T[K]; }

### The subset of 'T' naming only the keys in 'K'. 'K' is constrained to 'keyof(T)' rather than
### matched against it, so an unknown key is a compile error at the call site instead of silently
### mapping to nothing.
interface Pick<T, K: keyof(T)> { [P from K]: T[P]; }

### Every member of 'T' made optional, whatever 'T' itself said. The value clause carries the '?'
### directly - a mapped type reshapes each member's type as freely as it reshapes mutability.
interface Partial<T> { [K from keyof(T)]: T[K]?; }

### The return type of a function type, or 'never' for anything that is not one. 'R' is bound from
### the position a function's own signature never names on the way in - only 'T is fn(...): R'
### itself can read it back out.
type ReturnType<T> = T is fn(..unknown[]): let R ? R : never;

### The element type of an array type, or 'never' for anything that is not one.
type ElementType<T> = T is (let E)[] ? E : never;

### 'T' with 'none' no longer part of it. The '?' has to sit inside the parenthesized target
### ('(let U?)') rather than after it - a postfix '?' immediately outside a parenthesized target is
### read as the end of an optional type predicate, not as part of the pattern being matched (see
### CLAUDE.md's note on '_suppressOptionalSuffix').
type NonNullable<T> = T is (let U?) ? U : T;

### Every member of the union 'T' that is assignable to 'U' removed, member by member. A member
### that is not itself a match for 'U' passes through unchanged via the unconstrained second arm;
### one that is becomes 'never', which a union simplifies away.
type Exclude<T, U> = match each T {
    U -> never,
    let Other -> Other,
};

### The complement of 'Exclude': every member of the union 'T' that is assignable to 'U', with the
### rest replaced by 'never'.
type Extract<T, U> = match each T {
    let Kept: U -> Kept,
    let _ -> never,
};

### The subset of 'T' with the keys in 'K' left out - the complement of 'Pick'. Built from 'Exclude'
### over 'T's own keys rather than a mapped type of its own, so the two never answer differently for
### the same 'T' and 'K'.
interface Omit<T, K> { [P from Exclude<keyof(T), K>]: T[P]; }

### Every member of 'T' with its optionality stripped, whatever 'T' itself said. The inverse of
### 'Partial', built the same way 'Partial' is - by reshaping each member's type - rather than by
### rejecting a 'T' that already had optional members.
interface Required<T> { [K from keyof(T)]: NonNullable<T[K]>; }

declare interface Set<T> {
    [T]: bool;
    size: number;
    is_empty: bool;
    has: fn(value: T): bool;
    union: fn(other: Set<T>): Set<T>;
    intersect: fn(other: Set<T>): Set<T>;
    difference: fn(other: Set<T>): Set<T>;
    is_subset_of: fn(other: Set<T>): bool;
    to_array: fn(): T[];
}

declare interface MutSet<T> {
    mut [T]: bool;
    size: number;
    is_empty: bool;
    has: fn(value: T): bool;
    add: fn(value: T): void;
    remove: fn(value: T): void;
    clear: fn(): void;
    union: fn(other: Set<T>): Set<T>;
    intersect: fn(other: Set<T>): Set<T>;
    difference: fn(other: Set<T>): Set<T>;
    is_subset_of: fn(other: Set<T>): bool;
    to_array: fn(): T[];
}

declare sealed interface SetStatic {
    of: fn<T>(..values: T[]): Set<T>;
    empty: fn<T>(): Set<T>;
}

declare sealed interface MutSetStatic {
    of: fn<T>(..values: T[]): MutSet<T>;
    empty: fn<T>(): MutSet<T>;
}

declare let Set: SetStatic;
declare let MutSet: MutSetStatic;

### Produces a sequence one element at a time. Implementing this makes a type usable directly in a
### 'for' loop: the loop calls 'next' until it answers none, so the iterator carries its own position
### and decides for itself what "the next one" means.
trait Iterator<T> {
    fn next(): T?;
}

enum AttributeTargets {
    Function = 1 << 0,
    Interface = 1 << 1,
    Property = 1 << 2,
    Event = 1 << 3,
}

enum CFrameType {
    Compressed,
    Precise,
}

declare fn attribute_usage(targets: AttributeTargets): void;
[attribute_usage(AttributeTargets.Function)]
declare fn metadata_only: void;

type LuauMetamethod = 
    "__add"
    | "__mul"
    | "__div"
    | "__idiv"
    | "__pow"
    | "__mod"
    | "__eq"
    | "__lt"
    | "__le";

[attribute_usage(AttributeTargets.Function | AttributeTargets.Property)]
declare fn luau_metamethod(name: LuauMetamethod): void;
[attribute_usage(AttributeTargets.Function | AttributeTargets.Event | AttributeTargets.Property)]
declare fn luau_name(name: string): void;
[attribute_usage(AttributeTargets.Property)]
declare fn luau_method: void;
[attribute_usage(AttributeTargets.Property)]
declare fn override: void;

### Declares that a function may panic - that it calls unwrap/expect, error(), or another
### [fallible] function. Panicking anywhere else is an error, so a signature never hides the
### fact that calling it can end the thread. Metadata only: it wraps nothing at runtime.
[attribute_usage(AttributeTargets.Function), metadata_only]
declare fn fallible: void;

### Declares that a call to this method raises rather than returning, and that the compiler should
### catch that instead of letting it end the thread: the call is lowered to an xpcall and its result
### becomes 'Result<T, RobloxError>'. Generated onto every Roblox API method classified as fallible,
### which is why the return type on those is already a Result. Metadata only.
[attribute_usage(AttributeTargets.Function | AttributeTargets.Property), metadata_only]
declare fn wraps_errors: void;

### Marks a member whose use should be warned about. Generated onto every API member the Roblox
### dump tags Deprecated; 'message' carries a hand-written replacement hint where one is known,
### since Roblox's metadata supplies none. Metadata only.
[attribute_usage(AttributeTargets.Function | AttributeTargets.Property | AttributeTargets.Event), metadata_only]
declare fn deprecated(message: string?): void;

### Declares that this function runs somewhere yielding is not allowed - a metamethod, or a callback
### Luau invokes across a C-call boundary such as table.sort's comparator. Awaiting inside one is an
### error, and so is marking it 'async': both mean the thread would yield where Luau raises rather
### than suspends. Metadata only: it wraps nothing at runtime.
### Only on a function: what it forbids is awaiting inside a body, and a property declares a
### signature rather than a body, so permitting it there would accept the attribute and enforce nothing.
[attribute_usage(AttributeTargets.Function), metadata_only]
declare fn no_yield: void;

### Narrows which realm may use this declaration, below whatever [realms] says about the directory
### it is written in. A shared module still replicates in full - marking a declaration inside one
### does not stop its code reaching the client - so this says who may *reach* it, and the guarantee
### that server code is never delivered at all remains the directory's to make. Metadata only.
[attribute_usage(AttributeTargets.Function | AttributeTargets.Interface | AttributeTargets.Property | AttributeTargets.Event), metadata_only]
declare fn server: void;
### Narrows this declaration to client code. See 'server'. Metadata only.
[attribute_usage(AttributeTargets.Function | AttributeTargets.Interface | AttributeTargets.Property | AttributeTargets.Event), metadata_only]
declare fn client: void;

## Serialization attributes. See TypeChecker.Serialization.cs for the co-requirement rules
## these carry: 'packed' requires 'serializable', every property attribute requires its
## containing interface to be 'serializable', and 'number_step' requires 'number_range'.

### Gives the interface a binary wire format, and emits the serializer and deserializer for it.
[attribute_usage(AttributeTargets.Interface)] declare fn serializable: void;
### Packs the interface's booleans into shared bits rather than a byte each. Requires 'serializable'.
[attribute_usage(AttributeTargets.Interface)] declare fn packed: void;
### Leaves the property out of the wire format entirely.
[attribute_usage(AttributeTargets.Property)] declare fn ignore_serialization: void;
### Narrows the property to a known range, so it serializes in as few bits as that range needs.
### @param min the smallest value the property may hold
### @param max the largest value the property may hold
[attribute_usage(AttributeTargets.Property)] declare fn number_range(min: number, max: number): void;
### Quantizes the property to multiples of 'step' within its range. Requires 'number_range'.
[attribute_usage(AttributeTargets.Property)] declare fn number_step(step: number): void;
### Chooses how the CFrame property is encoded - compressed, or with full precision.
[attribute_usage(AttributeTargets.Property)] declare fn cframe_type(ty: CFrameType): void;

### Parks the calling thread for at least 'seconds', or until the next frame when given none.
###
### The only part of Roblox's 'task' library Loom does not already cover: 'delay' is what an 'after'
### statement lowers to, 'spawn' is what calling an 'async fn' does, and the repeating case is
### 'every'. Sleeping had nothing, so this is it.
### @param seconds how long to wait for, defaulting to a single frame
### @returns how long it actually waited, which is never less than 'seconds'
declare async fn wait(seconds: number?): number;

### Raises 'message', ending the calling thread unless something catches it.
### @param message what to raise
### @param level how far up the call stack to blame, defaulting to the caller
declare fn error(message: string, level: number?): never;
### Writes its arguments to the output, separated by tabs.
declare fn print(..data: unknown[]): void;
### Converts any value to its string form.
declare fn string(value: unknown): string;
### Parses a value as a number, or 'none' when it does not describe one.
declare fn number(value: unknown): number?;

declare fn get_metadata<T>(member_name: string?, attribute: unknown): unknown[]?;
declare fn has_attribute<T>(member_name: string?, attribute: unknown): bool;