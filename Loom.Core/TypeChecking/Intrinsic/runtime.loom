## This file contains definitions that should import the runtime library if their types are used.

sealed interface Range {
    minimum: number;
    maximum: number;
    length: number;
    clamp: fn(n: number): number;
}

## Both arms carry both type parameters, even though each only stores one of them: a member is
## callable on 'Result<T, Error>' only when it exists on every arm of the union, and 'unwrap'
## cannot be typed 'fn(): T' on the error arm unless that arm knows what T is. The combinators
## below never survive to runtime - the generator lowers each one inline (see
## LuauGenerator.Expressions.cs), so neither arm is ever a table carrying functions.
interface ResultOk<T, Error> {
    ok: true;
    value: T;
    unwrap: fn(): T;
    expect: fn(message: string): T;
    unwrap_err: fn(): Error;
    expect_err: fn(message: string): Error;
    unwrap_or: fn<U>(fallback: U): T | U;
    unwrap_or_else: fn<U>(compute: fn(error: Error): U): T | U;
    map: fn<U>(transform: fn(value: T): U): Result<U, Error>;
    map_err: fn<F>(transform: fn(error: Error): F): Result<T, F>;
    and_then: fn<U>(transform: fn(value: T): Result<U, Error>): Result<U, Error>;
    or_else: fn<F>(fallback: fn(error: Error): Result<T, F>): Result<T, F>;
}

interface ResultError<T, Error> {
    ok: false;
    error: Error;
    unwrap: fn(): T;
    expect: fn(message: string): T;
    unwrap_err: fn(): Error;
    expect_err: fn(message: string): Error;
    unwrap_or: fn<U>(fallback: U): T | U;
    unwrap_or_else: fn<U>(compute: fn(error: Error): U): T | U;
    map: fn<U>(transform: fn(value: T): U): Result<U, Error>;
    map_err: fn<F>(transform: fn(error: Error): F): Result<T, F>;
    and_then: fn<U>(transform: fn(value: T): Result<U, Error>): Result<U, Error>;
    or_else: fn<F>(fallback: fn(error: Error): Result<T, F>): Result<T, F>;
}

type Result<T, Error> = ResultOk<T, Error> | ResultError<T, Error>;

declare sealed interface ResultStatic {
    ok: fn<T, Error>(value: T): Result<T, Error>;
    err: fn<T, Error>(error: Error): Result<T, Error>;
}

declare let Result: ResultStatic;

## A value that is not ready yet. Calling an 'async fn' starts it and hands back one of these, so
## two calls made one after the other are in flight together; 'await' is how the value comes back
## out. Unlike Result's combinators, these are real runtime functions rather than macros the
## generator inlines - settling a future has to release the threads parked on it, so there is
## nothing to inline away.
enum FutureStatus: string {
    Pending = "pending",
    Resolved = "resolved",
    Rejected = "rejected",
}

declare sealed interface Future<T> {
    status: FutureStatus;
    ### The settled value, or 'none' while the future is still pending or if it failed. Reading it
    ### never waits - 'await' is what waits.
    value: T?;
}

declare sealed interface FutureStatic {
    ### A future that is already settled with 'value', so a synchronous path can hand back the same
    ### type an asynchronous one does. Awaiting it never yields.
    resolved: fn<T>(value: T): Future<T>;
    ### A future that has already failed. Awaiting it re-raises 'error'.
    rejected: fn<T>(error: unknown): Future<T>;
    ### Waits for every future, keeping the results in the order the futures were given rather than
    ### the order they finished. The first rejection rejects the whole thing.
    all: fn<T>(futures: Future<T>[]): Future<T[]>;
    ### Settles with whichever future settles first, whether it resolved or rejected.
    race: fn<T>(futures: Future<T>[]): Future<T>;
}

declare let Future: FutureStatic;

## The error half of every fallible Roblox API call. 'traceback' is captured by the xpcall
## handler the generator installs, so it costs nothing unless the call actually threw; it is
## optional so a traceback-free mode stays possible without changing the type. Luau permits
## error() with any value, so 'message' is whatever was thrown, coerced to a string.
sealed interface RobloxError {
    message: string;
    traceback: string?;
}

## String-valued so the emitted kind is readable in a payload dump, and so the generated
## type alias stays a literal union instead of collapsing to 'number' like a numeric enum.
enum DeserializeErrorKind: string {
    Truncated = "truncated",
    InvalidTag = "invalid_tag",
    InvalidLength = "invalid_length",
    MissingBlob = "missing_blob",
    InvalidBlob = "invalid_blob",
}

## 'buffer' is absent when every field of the type encodes to zero bytes, 'blobs' when the
## value carries none — both are elided rather than sent as an empty buffer or table.
declare sealed interface Serialized {
    buffer: buffer?;
    blobs: unknown[]?;
}

declare sealed interface DeserializeError {
    kind: DeserializeErrorKind;
    field: string?;
    offset: number?;
}

## A serializable type's codec as a value, so it can be stored, passed to a generic network
## wrapper, or selected at runtime. Every [serializable] interface emits one.
declare sealed interface Serializer<T> {
    serialize: fn(value: T): Serialized;
    deserialize: fn(serialized: Serialized): Result<T, DeserializeError>;
    diff: fn(baseline: T, value: T): Serialized;
    apply_diff: fn(baseline: T, diff: Serialized): Result<T, DeserializeError>;
}

declare fn serialize_binary<T>(value: T): Serialized;
declare fn deserialize_binary<T>(serialized: Serialized): Result<T, DeserializeError>;
declare fn serializer<T>: Serializer<T>;

## Encodes only what changed between 'baseline' and 'value', diffing into structs, unions,
## optionals, array elements and map entries rather than resending a field wholesale - an
## unchanged field costs one bit. 'T' is inferred from 'baseline', so no type argument is needed.
declare fn diff_binary<T>(baseline: T, value: T): Serialized;

## Reconstructs the value a 'diff_binary' payload was taken against, given the same baseline the
## sender diffed from. A stale or mismatched baseline produces a wrong value rather than an error -
## the payload carries no baseline identity of its own to check it against.
declare fn apply_diff_binary<T>(baseline: T, diff: Serialized): Result<T, DeserializeError>;

## Picks a codec out of a key-to-type mapping interface using a runtime key. This is the generic
## case serializer::<T>() cannot express, since inside a wrapper's body the type is not known - only
## the key value is. The result stays exactly typed as Serializer<T[K]>, so no cast is needed.
declare fn serializer_of<T, K>(key: K): Serializer<T[K]>;