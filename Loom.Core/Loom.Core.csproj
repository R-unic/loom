<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Loom.Core</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="..\.editorconfig">
            <Link>.editorconfig</Link>
        </Content>
        <Content Include="..\.gitignore">
            <Link>.gitignore</Link>
        </Content>
        <Content Include="..\CLAUDE.md">
            <Link>CLAUDE.md</Link>
        </Content>
        <Content Include="..\AGENTS.md">
            <Link>AGENTS.md</Link>
        </Content>
        <Content Include="..\CODEOWNERS">
            <Link>CODEOWNERS</Link>
        </Content>
        <Content Include="..\CONTRIBUTING.md">
            <Link>CONTRIBUTING.md</Link>
        </Content>
        <Content Include="..\qodana.yaml">
            <Link>qodana.yaml</Link>
        </Content>
        <Content Include="..\README.md">
            <Link>README.md</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Loom.Config\Loom.Config.csproj"/>
        <ProjectReference Include="..\Loom.Luau\Loom.Luau.csproj"/>
    </ItemGroup>

    <!--
        The lowering helpers are internal because nothing outside the compiler has any business calling
        them, not because they are too small to be worth testing on their own: LuauIdentifiers decides
        whether a pipeline stage may be fused, and reaching it only through a fused pipeline tests the
        decision by its consequences rather than directly.
    -->
    <ItemGroup>
        <InternalsVisibleTo Include="Loom.Testing"/>
    </ItemGroup>

    <!--
        Intrinsic .loom sources are embedded rather than read off disk at runtime: Intrinsics.cs
        used to resolve a path relative to AppContext.BaseDirectory and scan it with
        Directory.GetFiles, which silently returns nothing in sandboxed hosts with no real
        filesystem (e.g. the Blazor WebAssembly playground), leaving every intrinsic unavailable.
        LogicalNames are listed explicitly (not globbed with %(RecursiveDir)) so the resource name
        always uses '/' regardless of the OS running the build - %(RecursiveDir) emits '\' on
        Windows, which Intrinsics.cs' Path.GetFileName lookup would then fail to split on under
        WASM's Unix-style path semantics.
    -->
    <ItemGroup>
        <EmbeddedResource Include="TypeChecking\Intrinsic\loom.loom">
            <LogicalName>Intrinsic/loom.loom</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="TypeChecking\Intrinsic\math.loom">
            <LogicalName>Intrinsic/math.loom</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="TypeChecking\Intrinsic\buffer.loom">
            <LogicalName>Intrinsic/buffer.loom</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="TypeChecking\Intrinsic\runtime.loom">
            <LogicalName>Intrinsic/runtime.loom</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="TypeChecking\Intrinsic\traits.loom">
            <LogicalName>Intrinsic/traits.loom</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="TypeChecking\Intrinsic\generated\None.loom">
            <LogicalName>Intrinsic/generated/None.loom</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="TypeChecking\Intrinsic\generated\PluginSecurity.loom">
            <LogicalName>Intrinsic/generated/PluginSecurity.loom</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <!--
        The Luau runtime support written into a project's include folder is embedded for the same
        reason the intrinsics above are, plus one more: a toolchain manager installs the compiler as
        a single binary. Rokit keeps exactly one file out of a release archive and discards its
        siblings, so an include folder shipped as Content next to the executable does not survive
        installation and FileManager.WriteIncludeFolder would find nothing to copy. LogicalNames are
        listed explicitly for the '/' separator, as above.
    -->
    <ItemGroup>
        <EmbeddedResource Include="Pipeline\Include\loom_runtime.luau">
            <LogicalName>Include/loom_runtime.luau</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Pipeline\Include\event.luau">
            <LogicalName>Include/event.luau</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

</Project>