<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Loom.Packages</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Loom.Config\Loom.Config.csproj"/>
    </ItemGroup>

    <!-- every file here names a package version, and the implicit System using makes 'Version' ambiguous -->
    <ItemGroup>
        <Using Include="Loom.Config.Version" Alias="Version"/>
    </ItemGroup>

</Project>
