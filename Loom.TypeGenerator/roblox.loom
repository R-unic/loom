    [luau_name("Connected")] connected: bool;
    [luau_name("Disconnect"), luau_method] disconnect: fn: void;
}

declare sealed interface SecurityCapabilities;

declare sealed interface DateTime {
    [luau_name("UnixTimestamp")] unix_timestamp: number;
    [luau_name("UnixTimestampMillis")] unix_timestamp_millis: number;

    [luau_name("ToUniversalTime"), luau_method] to_universal_time: fn: TimeTable;
    [luau_name("ToLocalTime"), luau_method] to_local_time: fn: TimeTable;
    [luau_name("ToIsoDate"), luau_method] to_iso_date: fn: string;
    [luau_name("FormatUniversalTime"), luau_method] format_universal_time: fn(format: string, locale: string): string;
    [luau_name("FormatLocalTime"), luau_method] format_local_time: fn(format: string, locale: string): string;

    static now: fn: DateTime;
    [luau_name("fromIsoDate")] static fromIsoDate: fn(isoDate: string): DateTime?;
    [luau_name("fromLocalTime")] static from_local_time: fn(year: number?, month: number?, day: number?, hour: number?, minute: number?, second: number?, millisecond: number?): DateTime;
    [luau_name("fromUniversalTime")] static from_universal_time: fn(year: number?, month: number?, day: number?, hour: number?, minute: number?, second: number?, millisecond: number?): DateTime;
    [luau_name("fromUnixTimestamp")] static from_unix_timestamp: fn(unixTimestamp: number): DateTime;
    [luau_name("fromUnixTimestampMillis")] static from_unix_timestampMillis: fn(unixTimestampMillis: number): DateTime;
}

declare sealed interface Content {
    [luau_name("SourceType")] source_type: Enum["ContentSourceType"];
    [luau_name("Uri")] uri: string?;
    [luau_name("Object")] object: Object?;

    [luau_name("none")] static _none: Content;
    [luau_name("fromUri")] static from_uri: fn(uri: string): Content;
    [luau_name("fromObject")] static from_object: fn(object: Object): Content;
}

declare sealed interface Vector2<T: number = f32> {
    [luau_name("X")] x: number;
    [luau_name("Y")] y: number;
    [luau_name("Magnitude")] magnitude: number;
    [luau_name("Unit")] unit: Vector2;
    
    [luau_name("Abs"), luau_method] abs: fn: Vector2;
    [luau_name("Ceil"), luau_method] ceil: fn: Vector2;
    [luau_name("Floor"), luau_method] floor: fn: Vector2;
    [luau_name("Sign"), luau_method] sign: fn: Vector2;
    [luau_name("Cross"), luau_method] cross: fn(other: Vector2): Vector2;
    [luau_name("Angle"), luau_method] angle: fn(other: Vector2, isSigned: bool): number;
    [luau_name("Dot"), luau_method] dot: fn(other: Vector2): number;
    [luau_name("FuzzyEq"), luau_method] fuzzy_eq: fn(other: Vector2, epsilon: number?): bool;
    [luau_name("Lerp"), luau_method] lerp: fn(goal: Vector2, alpha: number): Vector2;
    [luau_name("Max"), luau_method] max: fn(other: Vector2): Vector2;
    [luau_name("Min"), luau_method] min: fn(other: Vector2): Vector2;
    
    [luau_metamethod("__add")]
    add: fn(other: Vector3): Vector3;
    [luau_metamethod("__sub")]
    sub: fn(other: Vector3): Vector3;
    [luau_metamethod("__mul")]
    mul: fn(other: Vector3 | number): Vector3;
    [luau_metamethod("__div")]
    div: fn(other: Vector3 | number): Vector3;
    [luau_metamethod("__idiv")]
    idiv: fn(other: Vector3 | number): Vector3;

    static zero: Vector2;
    static one: Vector2;
    [luau_name("yAxis")] static y_axis: Vector2;
    [luau_name("xAxis")] static x_axis: Vector2;
    [luau_name("zAxis")] static z_axis: Vector2;
    [luau_name("new")] static create: fn: Vector2;
    [luau_name("new")] static create: fn(x: number, y: number): Vector2;
}

declare sealed interface Vector2int16 {
    [luau_name("X")] x: number;
    [luau_name("Y")] y: number;
    
    [luau_metamethod("__add")]
    add: fn(other: Vector2int16): Vector2int16;
    [luau_metamethod("__sub")]
    sub: fn(other: Vector2int16): Vector2int16;
    [luau_metamethod("__mul")]
    mul: fn(other: Vector2int16): Vector2int16;
    [luau_metamethod("__div")]
    div: fn(other: Vector2int16): Vector2int16;
}

