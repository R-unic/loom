declare sealed interface CFrame<T: number = f32> {
    [luau_name("X")] x: number;
    [luau_name("Y")] y: number;
    [luau_name("Z")] z: number;
    [luau_name("Position")] position: Vector3;
    [luau_name("Rotation")] rotation: CFrame;
    [luau_name("LookVector")] look_vector: Vector3;
    [luau_name("RightVector")] right_vector: Vector3;
    [luau_name("UpVector")] up_vector: Vector3;
    [luau_name("XVector")] x_vector: Vector3;
    [luau_name("YVector")] y_vector: Vector3;
    [luau_name("ZVector")] z_vector: Vector3;

    [luau_name("Inverse"), luau_method] inverse: fn: CFrame;
    [luau_name("Lerp"), luau_method] lerp: fn(goal: CFrame, alpha: number): CFrame;
    [luau_name("ToWorldSpace"), luau_method] to_world_space: fn(cf: CFrame): CFrame;
    [luau_name("ToObjectSpace"), luau_method] to_object_space: fn(cf: CFrame): CFrame;
    [luau_name("PointToWorldSpace"), luau_method] point_to_world_space: fn(point: Vector3): Vector3;
    [luau_name("PointToObjectSpace"), luau_method] point_to_object_space: fn(point: Vector3): Vector3;
    [luau_name("VectorToWorldSpace"), luau_method] vector_to_world_space: fn(vector: Vector3): Vector3;
    [luau_name("VectorToObjectSpace"), luau_method] vector_to_object_space: fn(vector: Vector3): Vector3;

    ## Decomposition. Roblox exposes no ToQuaternion, so serializing a rotation goes through
    ## get_components and converts the 3x3 rotation matrix by hand - see the runtime library.
    [luau_name("GetComponents"), luau_method] get_components: fn: (
        number, number, number,
        number, number, number,
        number, number, number,
        number, number, number
    );

    [luau_name("ToOrientation"), luau_method] to_orientation: fn: (number, number, number);
    [luau_name("ToEulerAnglesXYZ"), luau_method] to_euler_angles_xyz: fn: (number, number, number);
    [luau_name("ToEulerAnglesYXZ"), luau_method] to_euler_angles_yxz: fn: (number, number, number);
    [luau_name("ToAxisAngle"), luau_method] to_axis_angle: fn: (Vector3, number);

    static identity: CFrame;
    [luau_name("Angles")] static angles: fn(x: number, y: number, z: number): CFrame;
    [luau_name("lookAt")] static look_at: fn(at: Vector3, lookAt: Vector3, up: Vector3?): CFrame;
    [luau_name("lookAlong")] static look_along: fn(at: Vector3, direction: Vector3, up: Vector3?): CFrame;
    [luau_name("fromEulerAngles")] static from_euler_angles: fn(x: number, y: number, z: number, order: Enum["RotationOrder"]?): CFrame;
    [luau_name("fromEulerAnglesXYZ")] static from_euler_angles_xyz: fn(x: number, y: number, z: number): CFrame;
    [luau_name("fromEulerAnglesYXZ")] static from_euler_angles_yxz: fn(x: number, y: number, z: number): CFrame;
    [luau_name("fromOrientation")] static from_orientation: fn(x: number, y: number, z: number): CFrame;
    [luau_name("fromAxisAngle")] static from_axis_angle: fn(vector: Vector3, rotation: number): CFrame;
    [luau_name("fromMatrix")] static from_matrix: fn(pos: Vector3, vX: Vector3, vY: Vector3, vZ: Vector3): CFrame;
    [luau_name("new")] static create: fn: CFrame;
    [luau_name("new")] static create: fn(pos: Vector3): CFrame;
    [luau_name("new")] static create: fn(pos: Vector3, lookAt: Vector3): CFrame;
    [luau_name("new")] static create: fn(x: number, y: number, z: number): CFrame;
    [luau_name("new")] static create: fn(x: number, y: number, z: number, qX: number, qY: number, qZ: number, qW: number): CFrame;
    [luau_name("new")] static create: fn(
        x: number, y: number, z: number,
        r00: number, r01: number, r02: number,
        r10: number, r11: number, r12: number,
        r20: number, r21: number, r22: number
    ): CFrame;
}

